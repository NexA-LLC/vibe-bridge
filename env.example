# Copy to .env, then run:
#   pnpm run start:api:env
#   pnpm run start:runner:env

# Control Plane API
API_TOKEN=dev
PORT=3900

# Runner (local executor)
VIBE_BRIDGE_API_BASE=http://127.0.0.1:3900
VIBE_BRIDGE_API_TOKEN=dev
# Recommended: a stable per-user directory (avoid /tmp because it may be cleaned)
VIBE_BRIDGE_WORKSPACE_ROOT=~/.vibe-bridge/work

# Optional (FlowAlign queue integration)
# FLOWALIGN_VIBE_BRIDGE_QUEUE_BASE_URL=https://<flowalign-base>
# FLOWALIGN_VIBE_BRIDGE_QUEUE_TOKEN=<FLOWALIGN_VIBE_BRIDGE_WEBHOOK_TOKEN>

