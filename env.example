# Copy to .env, then run:
#   pnpm run start:api:env
#   pnpm run start:runner:env

# Control Plane API
API_TOKEN=dev
PORT=3900

# Runner (local executor)
VIBE_BRIDGE_API_BASE=http://127.0.0.1:3900
VIBE_BRIDGE_API_TOKEN=dev
# Recommended: a stable per-user directory (avoid /tmp because it may be cleaned)
VIBE_BRIDGE_WORKSPACE_ROOT=~/.vibe-bridge/work
# Optional: command allowlist (YAML/JSON). When strict, runner requires commandId.
# VIBE_BRIDGE_COMMANDS_FILE=./config/commands.yml
# VIBE_BRIDGE_COMMANDS_LOCAL_FILE=~/.config/vibe-bridge/commands.local.yml
# VIBE_BRIDGE_COMMANDS_STRICT=1

# Optional AI executor defaults for kind=ai jobs.
# Job params can override with {"aiBackend":"codex-cli|codex-app-server|cursor-cli|cursor-api|claude-code|local-llm|openai-compatible|command"}.
# VIBE_BRIDGE_AI_BACKEND=codex-cli
# VIBE_BRIDGE_CODEX_BIN=codex
# VIBE_BRIDGE_CODEX_APP_SERVER_REMOTE=unix:///Users/me/.codex/app-server-control/app-server-control.sock
# VIBE_BRIDGE_CURSOR_BIN=cursor-agent
# VIBE_BRIDGE_CURSOR_COMMAND='cursor-agent --print --trust --workspace "{{cwd}}" "$(cat "{{promptFile}}")" > "{{outputFile}}"'
# VIBE_BRIDGE_CLAUDE_BIN=claude
# VIBE_BRIDGE_AI_COMMAND='my-agent --cwd "{{cwd}}" --prompt-file "{{promptFile}}" --out "{{outputFile}}"'

# Optional OpenAI-compatible local LLM backend for kind=ai + aiBackend=local-llm.
# VIBE_BRIDGE_LLM_BASE_URL=http://127.0.0.1:1234/v1
# VIBE_BRIDGE_LLM_API_KEY=sk-local
# VIBE_BRIDGE_LLM_MODEL=auto

# Optional OpenAI-compatible API backends for kind=ai + aiBackend=openai-compatible/cursor-api.
# VIBE_BRIDGE_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# VIBE_BRIDGE_OPENAI_API_KEY=sk-local
# VIBE_BRIDGE_OPENAI_MODEL=auto
# VIBE_BRIDGE_CURSOR_API_BASE_URL=https://api.cursor.com/v1
# VIBE_BRIDGE_CURSOR_API_KEY=
# VIBE_BRIDGE_CURSOR_API_MODEL=gpt-5

# Optional (FlowAlign queue integration)
# FLOWALIGN_VIBE_BRIDGE_QUEUE_BASE_URL=https://<flowalign-base>
# FLOWALIGN_VIBE_BRIDGE_QUEUE_TOKEN=<FLOWALIGN_VIBE_BRIDGE_WEBHOOK_TOKEN>
